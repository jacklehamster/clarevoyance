  "dialogues": {
    "intro": [
      {"text": "Pim's Rest: a few penguins, a pond, and ruins nobody is allowed into."},
      {"speaker": "hero", "text": "Someone here must know what is behind that gate."}
    ],
    "elder": [
      {
        "if": {"has": "crown"},
        "speaker": "elder",
        "text": "The lost crown! So the old stories were true..."
      },
      {"if": {"has": "crown"}, "speaker": "hero", "text": "It was just sitting there. In a chest."},
      {
        "if": {"has": "crown"},
        "speaker": "elder",
        "end": true,
        "text": "Keep it safe, Clare. Something tells me this is only the beginning."
      },
      {
        "if": {"flag": "herb_quest", "value": 2},
        "speaker": "elder",
        "end": true,
        "text": "The ruins are north, past Bram. Mind the patrol inside."
      },
      {
        "if": {"all": [{"flag": "herb_quest", "value": 1}, {"item": "herb", "op": "ge", "value": 3}]},
        "speaker": "elder",
        "text": "Three moonherbs! My knees thank you already.",
        "take": {"herb": 3},
        "set": {"elder_paying": 1}
      },
      {
        "if": {"all": [{"flag": "elder_paying", "value": 1}, {"flag": "greedy", "value": 1}]},
        "speaker": "elder",
        "end": true,
        "text": "You asked what was in it for you. Here: the key to the old ruins. Kindness would have earned you the same.",
        "give": {"key": 1},
        "set": {"herb_quest": 2, "elder_paying": 0}
      },
      {
        "if": {"flag": "elder_paying", "value": 1},
        "speaker": "elder",
        "end": true,
        "text": "Take this key to the old ruins. It is no use to an old penguin.",
        "give": {"key": 1},
        "set": {"herb_quest": 2, "elder_paying": 0}
      },
      {
        "if": {"flag": "herb_quest", "value": 1},
        "speaker": "elder",
        "end": true,
        "text": "Still looking? Moonherbs like open ground, out past the hedges. I need three."
      },
      {
        "if": {"flag": "met_elder", "value": 0},
        "speaker": "elder",
        "set": {"met_elder": 1},
        "text": "Oh! A traveller. I am Pim, elder of this village, such as it is."
      },
      {
        "speaker": "elder",
        "text": "My knees ache something fierce. Would you gather three moonherbs for me?",
        "choices": [
          {"text": "Of course.", "set": {"herb_quest": 1}},
          {"text": "What is in it for me?", "set": {"herb_quest": 1, "greedy": 1}},
          {"text": "Not now.", "set": {"elder_later": 1}}
        ]
      },
      {
        "if": {"flag": "elder_later", "value": 1},
        "speaker": "elder",
        "end": true,
        "set": {"elder_later": 0},
        "text": "No matter. I am not going anywhere."
      },
      {
        "if": {"flag": "greedy", "value": 1},
        "speaker": "elder",
        "end": true,
        "text": "Hmph. Bring them and you will see."
      },
      {"speaker": "elder", "end": true, "text": "Bless you. They grow in the meadows around the village."}
    ],
    "merchant": [
      {
        "if": {"flag": "bought_lantern", "value": 1},
        "speaker": "merchant",
        "end": true,
        "text": "Mind the lantern oil. No refunds!"
      },
      {"speaker": "merchant", "text": "Lanterns! Finest wicks this side of the pond. Two coins."},
      {
        "if": {"item": "coin", "op": "ge", "value": 2},
        "speaker": "hero",
        "text": "Two coins...",
        "choices": [
          {"text": "Buy a lantern (2 coins).", "set": {"buying": 1}},
          {"text": "Just looking.", "set": {"buying": 0}}
        ]
      },
      {
        "if": {"flag": "buying", "value": 1},
        "speaker": "merchant",
        "end": true,
        "text": "A pleasure doing business. It never goes out. Mostly.",
        "take": {"coin": 2},
        "give": {"lantern": 1},
        "set": {"bought_lantern": 1, "buying": 0}
      },
      {
        "if": {"item": "coin", "op": "ge", "value": 2},
        "speaker": "merchant",
        "end": true,
        "text": "Come back when you need light."
      },
      {"speaker": "hero", "text": "I do not have two coins."},
      {"speaker": "merchant", "end": true, "text": "Then look around! Penguins drop coins everywhere."}
    ],
    "guard": [
      {
        "if": {"flag": "gate_open", "value": 1},
        "speaker": "guard",
        "end": true,
        "text": "Go on in. And do not touch anything. ...You are going to touch everything."
      },
      {"speaker": "guard", "text": "Halt. The old ruins are sealed, by order of the elder."},
      {
        "if": {"all": [{"has": "key"}, {"has": "lantern"}]},
        "speaker": "hero",
        "text": "I have the elder's key. And a lantern."
      },
      {
        "if": {"all": [{"has": "key"}, {"has": "lantern"}]},
        "speaker": "guard",
        "end": true,
        "text": "Key, lantern... fine. In you go.",
        "set": {"gate_open": 1}
      },
      {
        "if": {"has": "key"},
        "speaker": "guard",
        "end": true,
        "text": "A key, good. But it is pitch dark in there: no lantern, no entry. Nina sells them."
      },
      {
        "if": {"has": "lantern"},
        "speaker": "guard",
        "end": true,
        "text": "Nice lantern. You still need the elder's key."
      },
      {
        "speaker": "guard",
        "text": "Anything else?",
        "choices": [
          {"text": "What is in there?", "set": {"guard_ask": 1}},
          {"text": "Who are you?", "set": {"guard_ask": 2}},
          {"text": "Never mind.", "set": {"guard_ask": 0}}
        ]
      },
      {
        "if": {"flag": "guard_ask", "value": 1},
        "speaker": "guard",
        "end": true,
        "text": "Old stones, older secrets. They say a crown sleeps in a chest. I say: rats."
      },
      {
        "if": {"flag": "guard_ask", "value": 2},
        "speaker": "guard",
        "end": true,
        "text": "Bram. I guard this gate. It is a very good gate."
      }
    ],
    "sleeper": [
      {
        "if": {"has": "lantern"},
        "speaker": "sleeper",
        "end": true,
        "text": "Agh! Turn that light off! Some of us are sleeping!"
      },
      {"speaker": "sleeper", "text": "Zzz... five more winters..."},
      {"speaker": "hero", "text": "(Fast asleep.)"}
    ],
    "found_crown": [{"text": "A crown, heavier than it looks. The elder will want to see this."}]
  },
  "entities": [],
  "events": [
    {"trigger": {"type": "start"}, "actions": [{"type": "talk", "id": "intro"}]},
